{
  "expo": {
    "name": "ビジトーク",
    "slug": "bizitalk-mobile",
    "scheme": "bizitalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bizitalk.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bizitalk.app",
      "adaptiveIcon": {
        "backgroundColor": "#12182B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f5f7fa",
          "dark": {
            "backgroundColor": "#0b0f1a"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AI会話練習で音声を録音するためにマイクを使用します。"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "AI会話練習で音声を録音するためにマイクを使用します。",
          "cameraPermission": "このアプリは音声のみで通信し、カメラは使用しません。"
        }
      ],
      "expo-iap"
    ],
    "extra": {
      "router": {}
    }
  }
}
