# ── Required ────────────────────────────────────────────────────────────
# Same Supabase project as the web app (Supabase dashboard > Project
# Settings > API). This is what makes the app log in to the SAME accounts
# as the website: one email address = one account on both.
# Only the public anon key is ever bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The deployed web app's URL (Vercel), no trailing slash. The app calls its
# existing API routes (conversation, feedback, TTS, purchases...) with an
# `Authorization: Bearer <Supabase access token>` header.
# For a local backend use your computer's LAN IP, e.g. http://192.168.0.10:3000
EXPO_PUBLIC_API_BASE_URL=https://bizitalkapp.com

# ── iOS in-app purchase (App Store Connect product IDs) ─────────────────
# Must be the same values as the web app's APPLE_PRODUCT_ID_* env vars,
# since the server maps a verified purchase back to a plan with them.
EXPO_PUBLIC_APPLE_PRODUCT_ID_TRIAL=
EXPO_PUBLIC_APPLE_PRODUCT_ID=
EXPO_PUBLIC_APPLE_PRODUCT_ID_UNLIMITED=
