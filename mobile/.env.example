# Same Supabase project as the web app (Settings > API in the Supabase dashboard).
# Only the public anon key is ever bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed web app (Vercel). The app calls its API routes
# (checkout, portal, conversation realtime-token/messages/end, TTS audio)
# with an Authorization: Bearer <supabase access token> header.
# Use your local `next dev` URL (e.g. http://192.168.x.x:3000, a LAN IP so a
# physical device/simulator can reach it) while developing against a local
# backend, or the production URL once deployed.
EXPO_PUBLIC_API_BASE_URL=https://bizitalk.example.com

# Optional — same Stripe Price IDs as the web app's STRIPE_PRICE_ID*
# (not secret; used only to highlight the user's current plan on the
# pricing screen). Leave unset and that highlighting just won't
# distinguish AI conversation tiers from each other.
EXPO_PUBLIC_STRIPE_PRICE_ID_TRIAL=
EXPO_PUBLIC_STRIPE_PRICE_ID=
EXPO_PUBLIC_STRIPE_PRICE_ID_UNLIMITED=

# Required for the iOS purchase flow (StoreKit) — same four App Store
# Connect product identifiers as the web app's APPLE_PRODUCT_ID* env vars.
# Not secret (shown to users in the system purchase sheet). Android is
# unaffected — it keeps using Stripe checkout.
EXPO_PUBLIC_APPLE_PRODUCT_ID_LISTENING=
EXPO_PUBLIC_APPLE_PRODUCT_ID_TRIAL=
EXPO_PUBLIC_APPLE_PRODUCT_ID=
EXPO_PUBLIC_APPLE_PRODUCT_ID_UNLIMITED=
