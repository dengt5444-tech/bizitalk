# Supabase (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (used for the AI conversation partner, real-time voice, TTS
# fallback voice, and end-of-session feedback)
OPENAI_API_KEY=

# Stripe — four plans, four separate prices
STRIPE_SECRET_KEY=
# AI conversation, "standard" tier (¥4,990/month)
STRIPE_PRICE_ID=
# AI conversation, "trial" tier — a little AI + unlimited listening (¥980/month)
STRIPE_PRICE_ID_TRIAL=
# AI conversation, "unlimited" tier (¥9,900/month)
STRIPE_PRICE_ID_UNLIMITED=
# Listening-materials only, no AI conversation (¥490/month)
STRIPE_PRICE_ID_LISTENING=
STRIPE_WEBHOOK_SECRET=

# Public site URL, used for Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that get full paid access without a Stripe subscription
ADMIN_EMAILS=

# Apple In-App Purchase (iOS app only — Android/Web keep using Stripe above).
# All of these come from App Store Connect once the Apple Developer Program
# account and app record exist; see mobile/RELEASE_CHECKLIST.md.
APPLE_BUNDLE_ID=com.bizitalk.app
# Numeric App Store app ID (Apple ID), used for extra validation of
# production notifications. Optional — omit until the app has one.
APPLE_APP_APPLE_ID=
# Not required by the current code — verifying a purchase or a Server
# Notification only needs Apple's public root certificate (bundled in
# src/lib/apple/rootCertificates.ts), not these. Reserved for if we later
# add calls to Apple's App Store Server API itself (e.g. an admin tool to
# look up a subscription's live status, or backfilling history) — from
# App Store Connect > Users and Access > Integrations > In-App Purchase key.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# The .p8 private key file's contents, PEM format (including the
# -----BEGIN/END PRIVATE KEY----- lines). If your env var storage can't
# hold literal newlines, store it with \n escapes.
APPLE_IAP_PRIVATE_KEY=
# App Store Connect product identifiers — one per plan, same four plans as
# the Stripe prices above.
APPLE_PRODUCT_ID_LISTENING=
APPLE_PRODUCT_ID_TRIAL=
APPLE_PRODUCT_ID=
APPLE_PRODUCT_ID_UNLIMITED=

# Sentry error monitoring (optional — everything is a safe no-op if left
# unset). SENTRY_DSN covers server/edge; NEXT_PUBLIC_SENTRY_DSN covers the
# browser. SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are only needed to
# upload source maps at build time for readable stack traces.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
