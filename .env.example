# Supabase (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (used for the AI conversation partner, real-time voice, TTS
# fallback voice, and end-of-session feedback)
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
# Price ID for the AI conversation plan (¥2,980/month)
STRIPE_PRICE_ID=
# Price ID for the listening-materials plan (¥490/month) — a separate
# Stripe product from the AI conversation plan above
STRIPE_PRICE_ID_LISTENING=
STRIPE_WEBHOOK_SECRET=

# Public site URL, used for Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that get full paid access without a Stripe subscription
ADMIN_EMAILS=
