# Supabase (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (used for the AI conversation partner, real-time voice, TTS
# fallback voice, and end-of-session feedback)
OPENAI_API_KEY=

# Stripe — four plans, four separate prices
STRIPE_SECRET_KEY=
# AI conversation, "standard" tier (¥4,990/month)
STRIPE_PRICE_ID=
# AI conversation, "trial" tier — a little AI + unlimited listening (¥980/month)
STRIPE_PRICE_ID_TRIAL=
# AI conversation, "unlimited" tier (¥9,900/month)
STRIPE_PRICE_ID_UNLIMITED=
# Listening-materials only, no AI conversation (¥490/month)
STRIPE_PRICE_ID_LISTENING=
STRIPE_WEBHOOK_SECRET=

# Public site URL, used for Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that get full paid access without a Stripe subscription
ADMIN_EMAILS=

# Sentry error monitoring (optional — everything is a safe no-op if left
# unset). SENTRY_DSN covers server/edge; NEXT_PUBLIC_SENTRY_DSN covers the
# browser. SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are only needed to
# upload source maps at build time for readable stack traces.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
